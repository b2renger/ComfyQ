  },
  "2": {
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Qwen-Image VAE"
    }
  },
  "3": {
    "inputs": {
      "pixels": [
        "1",
        0
      ],
      "vae": [
        "2",
        0
      ]
    },
    "class_type": "VAEEncode",
    "_meta": {
      "title": "Encode the image to a latent"
    }
  },
  "4": {
    "inputs": {
      "unet_name": "pid_1.5_qwenimage_1024_to_4096_4step_bf16.safetensors",
