    "class_type": "CLIPLoader",
    "_meta": {
      "title": "PiD text encoder (Gemma)"
    }
  },
  "6": {
    "inputs": {
      "text": "",
      "clip": [
        "5",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "PiD prompt (empty is fine)"
    }
  },
  "7": {
    "inputs": {
      "latent_format": "qwenimage",
      "max_tile": 1024,
      "overlap": 64,
      "seed": 42,
      "degrade_sigma": 0,
      "model": [
        "4",
        0
      ],
      "positive": [
        "6",
        0
      ],
      "latent": [
        "3",
        0
      ]
    },
    "class_type": "LatentTiledPiDDecode",
    "_meta": {
      "title": "Latent-Tiled PiD Decode (4x)"
