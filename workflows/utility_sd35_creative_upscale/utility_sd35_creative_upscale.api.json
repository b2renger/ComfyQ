{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "example.png"
    },
    "_meta": {
      "title": "The picture to upscale"
    }
  },
  "2": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "upscale_method": "lanczos",
      "megapixels": 1.5,
      "resolution_steps": 16
    },
    "_meta": {
      "title": "Take it up to size (snaps to SD3 grid, keeps aspect)"
    }
  },
  "3": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd3.5_large_fp8_scaled.safetensors"
    },
    "_meta": {
      "title": "SD3.5 Large (model + encoders + VAE in one file)"
    }
  },
  "4": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": [
        "3",
        0
      ],
      "shift": 3
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "3",
        1
      ],
      "text": "a sharp, high quality photograph, fine natural detail, realistic texture"
    },
    "_meta": {
      "title": "Prompt"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "3",
        1
      ],
      "text": "blurry, soft focus, low quality, jpeg artifacts, oversharpened, plastic skin, waxy"
    },
    "_meta": {
      "title": "Negative prompt"
    }
  },
  "7": {
    "class_type": "ControlNetLoader",
    "inputs": {
      "control_net_name": "sd3.5_large_controlnet_blur.safetensors"
    },
    "_meta": {
      "title": "SD3.5 ControlNet - blur (Stability's own upscaler)"
    }
  },
  "8": {
    "class_type": "ControlNetApplySD3",
    "inputs": {
      "positive": [
        "5",
        0
      ],
      "negative": [
        "6",
        0
      ],
      "control_net": [
        "7",
        0
      ],
      "vae": [
        "3",
        2
      ],
      "image": [
        "2",
        0
      ],
      "strength": 0.9,
      "start_percent": 0,
      "end_percent": 1
    },
    "_meta": {
      "title": "Resemblance"
    }
  },
  "9": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "2",
        0
      ],
      "vae": [
        "3",
        2
      ]
    }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "4",
        0
      ],
      "positive": [
        "8",
        0
      ],
      "negative": [
        "8",
        1
      ],
      "latent_image": [
        "9",
        0
      ],
      "seed": 20261005,
      "steps": 25,
      "cfg": 4.5,
      "sampler_name": "euler",
      "scheduler": "sgm_uniform",
      "denoise": 1.0
    },
    "_meta": {
      "title": "Creativity = denoise"
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "10",
        0
      ],
      "vae": [
        "3",
        2
      ]
    }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "11",
        0
      ],
      "filename_prefix": "SD35_creative_upscale"
    }
  }
}